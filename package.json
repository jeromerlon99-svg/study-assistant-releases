{
  "name": "study-assistant",
  "version": "0.1.7",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm --filter @study-assistant/desktop dev",
    "agent:dev": "python -m study_assistant_agent",
    "build": "pnpm --filter @study-assistant/desktop build",
    "sidecar:build": "powershell -ExecutionPolicy Bypass -File scripts/build-sidecar.ps1",
    "ffmpeg:prepare": "powershell -ExecutionPolicy Bypass -File scripts/prepare-ffmpeg.ps1",
    "release:build": "pnpm sidecar:build && pnpm ffmpeg:prepare && pnpm tauri build",
    "tauri": "pnpm --filter @study-assistant/desktop tauri",
    "typecheck": "pnpm --filter @study-assistant/desktop typecheck",
    "test:agent": "python -m pytest tests/agent -q",
    "lint:agent": "python -m ruff check services/agent/src tests/agent",
    "check:version": "node scripts/check-version.mjs",
    "check": "powershell -ExecutionPolicy Bypass -File scripts/check.ps1"
  }
}
