# Local Agent service
STUDY_ASSISTANT_HOST=127.0.0.1
STUDY_ASSISTANT_PORT=8765
# Leave empty to use runtime-data beside the repository or portable executable.
STUDY_ASSISTANT_DATA_DIR=

# OpenAI-compatible provider. API keys are deliberately session-only and are
# cleared on every launch, so no API key belongs in this file.
STUDY_ASSISTANT_API_BASE_URL=https://api.openai.com/v1
STUDY_ASSISTANT_TEXT_MODEL=
STUDY_ASSISTANT_REASONING_EFFORT=low
STUDY_ASSISTANT_LOCAL_WHISPER_MODEL=small

# The multilingual semantic model is an internal feature and has no user-facing
# model setting. Set this to false only for isolated development/tests.
STUDY_ASSISTANT_SEMANTIC_AUTO_INITIALIZE=true
